document.addEventListener('DOMContentLoaded', () => {
    // Initialization
    initThemeToggle();
    initMobileMenu();
    initExerciseSearchAndFilter();
    initWorkoutPlanner();
    initCalorieTracker();
    initExerciseTimer();
});

/* ==========================================================================
   1. Theme Toggle (Dark / Light Mode)
   ========================================================================== */
function initThemeToggle() {
    const themeBtn = document.getElementById('theme-toggle-btn');
    if (!themeBtn) return;

    // Load saved theme or default to light
    const savedTheme = localStorage.getItem('gym_theme') || 'light';
    document.body.classList.toggle('dark-theme', savedTheme === 'dark');

    themeBtn.addEventListener('click', () => {
        document.body.classList.toggle('dark-theme');
        const isDark = document.body.classList.contains('dark-theme');
        localStorage.setItem('gym_theme', isDark ? 'dark' : 'light');
    });
}

/* ==========================================================================
   2. Mobile Menu Toggle
   ========================================================================== */
function initMobileMenu() {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const navMenu = document.getElementById('nav-menu');

    if (!menuBtn || !navMenu) return;

    menuBtn.addEventListener('click', () => {
        navMenu.classList.toggle('active');
        menuBtn.classList.toggle('open');
    });
}

/* ==========================================================================
   3. Exercise Search & Muscle-Group Filtering
   ========================================================================== */
function initExerciseSearchAndFilter() {
    const searchInput = document.getElementById('exercise-search');
    const filterButtons = document.querySelectorAll('.filter-btn');
    const exerciseCards = document.querySelectorAll('.exercise-card');

    if (!exerciseCards.length) return;

    let currentFilter = 'all';
    let searchQuery = '';

    function filterExercises() {
        exerciseCards.forEach(card => {
            const muscleGroup = card.dataset.muscle ? card.dataset.muscle.toLowerCase() : '';
            const title = card.querySelector('.exercise-title')?.textContent.toLowerCase() || '';

            const matchesFilter = (currentFilter === 'all' || muscleGroup === currentFilter);
            const matchesSearch = title.includes(searchQuery);

            if (matchesFilter && matchesSearch) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });
    }

    // Search Input Event
    if (searchInput) {
        searchInput.addEventListener('input', (e) => {
            searchQuery = e.target.value.toLowerCase().trim();
            filterExercises();
        });
    }

    // Filter Buttons Event
    filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            filterButtons.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentFilter = btn.dataset.filter.toLowerCase();
            filterExercises();
        });
    });
}

/* ==========================================================================
   4. Workout Planner
   ========================================================================== */
function initWorkoutPlanner() {
    const plannerForm = document.getElementById('planner-form');
    const workoutInput = document.getElementById('workout-input');
    const daySelect = document.getElementById('day-select');
    const plannerList = document.getElementById('planner-list');

    if (!plannerForm || !plannerList) return;

    // Load Workouts from LocalStorage
    let workouts = JSON.parse(localStorage.getItem('dev_gym_workouts')) || [];

    function renderWorkouts() {
        plannerList.innerHTML = '';
        if (workouts.length === 0) {
            plannerList.innerHTML = '<li class="empty-msg">No workouts planned yet.</li>';
            return;
        }

        workouts.forEach((item, index) => {
            const li = document.createElement('li');
            li.className = 'planner-item';
            li.innerHTML = `
                <span><strong>${item.day}:</strong> ${item.name}</span>
                <button class="delete-btn" data-index="${index}">✖</button>
            `;
            plannerList.appendChild(li);
        });
    }

    plannerForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = workoutInput.value.trim();
        const day = daySelect.value;

        if (name) {
            workouts.push({ name, day });
            localStorage.setItem('dev_gym_workouts', JSON.stringify(workouts));
            workoutInput.value = '';
            renderWorkouts();
        }
    });

    plannerList.addEventListener('click', (e) => {
        if (e.target.classList.contains('delete-btn')) {
            const index = e.target.dataset.index;
            workouts.splice(index, 1);
            localStorage.setItem('dev_gym_workouts', JSON.stringify(workouts));
            renderWorkouts();
        }
    });

    renderWorkouts();
}

/* ==========================================================================
   5. Calorie & Progress Tracker
   ========================================================================== */
function initCalorieTracker() {
    const trackerForm = document.getElementById('tracker-form');
    const caloriesInput = document.getElementById('calories-input');
    const totalCaloriesDisplay = document.getElementById('total-calories');
    const progressBar = document.getElementById('calorie-progress-bar');
    const dailyGoal = 2000; // Target Calorie Goal

    if (!trackerForm || !totalCaloriesDisplay) return;

    let totalCalories = parseInt(localStorage.getItem('dev_gym_calories')) || 0;

    function updateDisplay() {
        totalCaloriesDisplay.textContent = totalCalories;
        if (progressBar) {
            const percentage = Math.min((totalCalories / dailyGoal) * 100, 100);
            progressBar.style.width = `${percentage}%`;
        }
    }

    trackerForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const calories = parseInt(caloriesInput.value);

        if (!isNaN(calories) && calories > 0) {
            totalCalories += calories;
            localStorage.setItem('dev_gym_calories', totalCalories);
            caloriesInput.value = '';
            updateDisplay();
        }
    });

    // Reset button (if available)
    const resetBtn = document.getElementById('reset-tracker-btn');
    if (resetBtn) {
        resetBtn.addEventListener('click', () => {
            totalCalories = 0;
            localStorage.setItem('dev_gym_calories', 0);
            updateDisplay();
        });
    }

    updateDisplay();
}

/* ==========================================================================
   6. Exercise Timer (Stopwatch/Countup)
   ========================================================================== */
function initExerciseTimer() {
    const timerDisplay = document.getElementById('timer-display');
    const startBtn = document.getElementById('timer-start');
    const pauseBtn = document.getElementById('timer-pause');
    const resetBtn = document.getElementById('timer-reset');

    if (!timerDisplay) return;

    let timerInterval = null;
    let seconds = 0;

    function formatTime(sec) {
        const mins = Math.floor(sec / 60).toString().padStart(2, '0');
        const secs = (sec % 60).toString().padStart(2, '0');
        return `${mins}:${secs}`;
    }

    function startTimer() {
        if (timerInterval) return;
        timerInterval = setInterval(() => {
            seconds++;
            timerDisplay.textContent = formatTime(seconds);
        }, 1000);
    }

    function pauseTimer() {
        clearInterval(timerInterval);
        timerInterval = null;
    }

    function resetTimer() {
        pauseTimer();
        seconds = 0;
        timerDisplay.textContent = formatTime(seconds);
    }

    if (startBtn) startBtn.addEventListener('click', startTimer);
    if (pauseBtn) pauseBtn.addEventListener('click', pauseTimer);
    if (resetBtn) resetBtn.addEventListener('click', resetTimer);
}
